{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xvirus Anti-Malware",
  "version": "8.0.0",
  "identifier": "net.xvirus.antimalware",
  "build": {
    "beforeDevCommand": "npm run web:dev:am",
    "beforeBuildCommand": "npm run web:build:am",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Xvirus",
        "width": 500,
        "height": 800,
        "center": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "decorations": false,
        "maximizable": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
