<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Xvirus</Authors>
    <Company>Xvirus</Company>
    <Copyright>Copyright $([System.DateTime]::Now.Year) $(Company)</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableStaticWebAssets>false</EnableStaticWebAssets>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Which product this build is: antimalware (default) or firewall.
         Pass /p:ProductMode=firewall to bake the firewall identity into the binary. -->
    <ProductMode Condition="'$(ProductMode)' == ''">antimalware</ProductMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ProductMode)' == 'firewall'">
    <DefineConstants>$(DefineConstants);FIREWALL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaseLibrary\BaseLibrary.csproj" />
  </ItemGroup>

</Project>
